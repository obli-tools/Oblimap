# Oblimap — Docker Compose settings. Copy to .env and fill in (install.sh
# generates a complete .env with random secrets). The compose files read every
# variable below (image tag, port, database, server environment); NODE_ENV is
# fixed to production there.
# Never commit your .env: it holds the database password and the secrets.

# ── Image version (tag Docker Hub, ex: latest, 1.0.0) ──
OBLIMAP_VERSION=latest

# ── Database ──
# Password of the built-in postgres container (docker-compose.yml).
# Generate one:  openssl rand -hex 24
# (hex only: it is embedded in a postgres:// URL, where / @ : ? # break it)
# Applied only when the postgres volume is first created: to change it later,
# also run ALTER USER oblimap PASSWORD '...' inside the database.
# Empty = insecure built-in default "changeme".
DB_PASSWORD=

# External PostgreSQL (docker-compose.external-db.yml) instead:
# DATABASE_URL=postgres://oblimap:yourpassword@your-db-host:5432/oblimap

# ── Web port (host port of the client container) ──
LISTEN_PORT=3002

# ── Public URL ──
# CLIENT_ORIGIN = where users (and probes) reach Oblimap, e.g.
# https://oblimap.example.com — CORS / socket / CSRF origin AND the public URL
# used in password-reset links and probe installers (same as every Obli* app).
CLIENT_ORIGIN=http://localhost
# Optional: only if the public URL must differ from CLIENT_ORIGIN.
APP_URL=
# "true" when users reach Oblimap over HTTPS (TLS reverse proxy in front, which
# must send X-Forwarded-Proto: https): the session cookie is then marked Secure.
FORCE_HTTPS=false

# ── App name (prefix of notification messages, e-mail subjects, 2FA issuer) ──
APP_NAME=Oblimap

# ── Sessions ──
# Signs the session cookie: at least 32 random characters.
# Generate one:  openssl rand -hex 32
# Empty = insecure built-in default (public; reported at startup).
# Changing it signs every user out.
SESSION_SECRET=
# Session cookie name, distinct per app so Obli* apps served on the same
# hostname do not overwrite each other's session. Default: oblimap.sid
#SESSION_COOKIE_NAME=oblimap.sid
# A session left unused for this many hours is closed. Default: 12
#SESSION_IDLE_TIMEOUT_HOURS=12

# ── Default admin (created on the first start only, while there is no user) ──
DEFAULT_ADMIN_USERNAME=admin
# Generate one:  openssl rand -base64 18
# Empty = the public built-in default (see README) — only acceptable for a
# throwaway test instance. Change the password after the first login.
DEFAULT_ADMIN_PASSWORD=
# The server warns at every start while DEFAULT_ADMIN_PASSWORD resolves to the
# built-in default. Once your accounts exist (the value is then unused), "true"
# silences that warning. Default: false
#ALLOW_DEFAULT_ADMIN_PASSWORD=false

# ── Two-factor authentication ──
# Recovery switch: "true" ignores the "Force 2FA" admin setting, e.g. to let
# users without 2FA back in when e-mail OTP cannot be delivered. Users who
# enabled 2FA still need it to sign in. Remove it once fixed. Default: false
#DISABLE_2FA_FORCE=false

# ── Encryption at rest of stored secrets ──
# AES-256-GCM key protecting secrets kept in the database (SMTP passwords,
# device-check credentials): base64 of exactly 32 random bytes.
# Generate one:  openssl rand -base64 32
# Without it, SMTP passwords stay in clear text in the database and
# device-check credentials cannot be saved.
# Back it up together with the database: losing or changing it makes the
# stored secrets unreadable.
DATA_ENCRYPTION_KEY=
# Identifier recorded next to each encrypted value. Default: k1
#DATA_ENCRYPTION_KEY_ID=k1
# Device-check credentials are only sent to probes over HTTPS (FORCE_HTTPS=true
# and a probe whose server URL is https://). "true" also sends them over plain
# HTTP, in clear text on the network, but only to probes that opted in too:
# "deviceChecks": {"allowPlaintextSecrets": true} in the probe's config.json
# (other probes would discard them). Default: false
#ALLOW_PLAINTEXT_PROBE_SECRETS=false

# ── Outbound requests (notification channels) ──
# Webhook-style notification channels refuse private, loopback and link-local
# targets (SSRF protection). Allowed anyway, e.g. an internal Gotify or ntfy
# server: comma-separated host names ("gotify.lan", "*.corp.example"),
# IP addresses or CIDRs ("192.168.10.0/24").
#SSRF_ALLOWLIST=gotify.lan,192.168.1.20

# ── Obligate SSO — optional inbound secret ──
# The client_id sent to the browser is always the public id sha256(API key): Obligate refuses the raw API key.
# Also in Settings > Obligate SSO Gateway; a value set here wins (the setting is
# then read-only there). Same name and value as in the other Obli* apps. Leave
# it empty to keep today's behaviour.
# OBLIGATE_INBOUND_SECRET: secret Obligate must present (Bearer) when it calls
#   this server (user sync, app info, dashboard stats). Empty = the API key is
#   expected. Set it ONLY once Obligate sends this separate secret, or its
#   calls are refused (401). 32 to 256 characters: openssl rand -hex 32
#   Outbound calls to Obligate always use the API key.
#OBLIGATE_INBOUND_SECRET=

# ── Device web proxy through the probes (tunnels) ──
# "Open web interface" on a tunnel serves the device's pages through the probe.
# Default (empty): on the Oblimap address, under /api/tunnel/p/<link>/, in a
# sandboxed tab — the device's scripts cannot reach your Oblimap session, but
# device logins that rely on cookies may not work there.
# Recommended: a host on a SEPARATE registrable domain routed to this same
# instance (same container / port as Oblimap: DNS record + edge proxy /
# certificate), e.g. with Oblimap on oblimap.example.com:
#   TUNNEL_ORIGIN=https://tunnel.example-devices.net
# Device pages are then served there, where no Oblimap cookie exists: no
# sandbox, device cookies and logins work, and that host reaches nothing but
# the proxy. Do NOT use a sub-domain or sibling of Oblimap's host (e.g.
# tunnel.oblimap.example.com or tunnel.example.com): device scripts run
# unsandboxed there and could set a cookie on the shared parent domain that
# replaces your Oblimap session (forced sign-out or session fixation); the
# server logs a warning at startup in that case. Leave empty to keep the
# sandboxed mode.
#TUNNEL_ORIGIN=

# Max probes of one API key waiting for approval (anti-flood if a key leaks).
# Raise it for large roll-outs installed before approval. Default 500.
#PROBE_MAX_PENDING_PER_KEY=500

# ── Client IP behind reverse proxies ──
# Only the X-Forwarded-For entries added by these proxies are believed; the
# client IP (audit logs, IP-based features) is the first address, from the
# right, that is not one of them.
# Comma-separated IPs, CIDRs or keywords: loopback, linklocal, uniquelocal,
# self (= the subnets of the server container's own interfaces, i.e. the
# client container's nginx whatever pool Docker uses).
# Default: loopback, self, 172.16.0.0/12 — covers the client nginx and an edge
# reverse proxy (Nginx Proxy Manager, Traefik...) running in Docker on the same
# host. A proxy on another machine must be listed, e.g.
#   TRUSTED_PROXIES=loopback, self, 172.16.0.0/12, 192.168.1.10
# Cloudflare (orange cloud) in front: add Cloudflare's published ranges, or
# everyone shows up as a Cloudflare edge address.
# Do not add ranges that real clients use (LAN / VPN in 10/8, 172.16/12,
# 192.168/16 reaching the proxy directly): a client inside a trusted range
# could forge its address.
#TRUSTED_PROXIES=loopback, self, 172.16.0.0/12
# Maximum X-Forwarded-For hops believed: edge proxy + client nginx = 2.
# Use 1 if the client container's port is published directly with no reverse
# proxy in front: with 2, such a client can choose the address it is seen with.
#TRUSTED_PROXY_HOPS=2
